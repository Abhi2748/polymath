{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "polymath.lesson/1",
 "title": "Polymath lesson pack, format 1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "topic_id",
  "title",
  "question",
  "est_minutes",
  "objectives",
  "key_terms",
  "guess",
  "hook",
  "explanation",
  "worked_example",
  "misconception",
  "cards",
  "recall_items",
  "teach_back",
  "challenge",
  "connections",
  "deep_dive",
  "go_further",
  "sources",
  "verification"
 ],
 "properties": {
  "format": {
   "const": "polymath.lesson/1"
  },
  "topic_id": {
   "type": "string",
   "pattern": "^[a-z]{3}[0-9]{2}$"
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "question": {
   "type": "string",
   "pattern": "\\?$"
  },
  "est_minutes": {
   "type": "integer",
   "minimum": 5,
   "maximum": 20
  },
  "objectives": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "items": {
    "type": "string"
   }
  },
  "key_terms": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "term",
     "definition"
    ],
    "properties": {
     "term": {
      "type": "string"
     },
     "definition": {
      "type": "string"
     }
    }
   }
  },
  "when": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "label"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "start_year": {
     "type": "integer"
    },
    "end_year": {
     "type": "integer"
    }
   }
  },
  "guess": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "prompt",
    "options",
    "answer_id",
    "reveal"
   ],
   "properties": {
    "prompt": {
     "type": "string"
    },
    "options": {
     "type": "array",
     "minItems": 2,
     "maxItems": 5,
     "items": {
      "$ref": "#/$defs/option"
     }
    },
    "answer_id": {
     "type": "string"
    },
    "reveal": {
     "type": "string"
    }
   }
  },
  "hook": {
   "type": "string",
   "maxLength": 400
  },
  "excerpt": {
   "type": "object",
   "additionalProperties": false,
   "description": "A passage of a primary text that the lesson studies. Only works first published before 1929, or works under an open licence.",
   "required": [
    "work",
    "author",
    "year",
    "text",
    "rights",
    "source_url"
   ],
   "properties": {
    "work": {
     "type": "string"
    },
    "author": {
     "type": "string"
    },
    "year": {
     "type": "integer"
    },
    "text": {
     "type": "string",
     "minLength": 20,
     "maxLength": 2500
    },
    "rights": {
     "enum": [
      "public_domain",
      "open_licence"
     ]
    },
    "licence": {
     "type": "string"
    },
    "source_url": {
     "type": "string",
     "pattern": "^https://"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "explanation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "body_md",
    "analogy",
    "takeaways",
    "visual"
   ],
   "properties": {
    "body_md": {
     "type": "string"
    },
    "analogy": {
     "type": "string"
    },
    "takeaways": {
     "type": "array",
     "minItems": 2,
     "maxItems": 4,
     "items": {
      "type": "string"
     }
    },
    "visual": {
     "$ref": "#/$defs/visual"
    }
   }
  },
  "positions": {
   "type": "array",
   "minItems": 2,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "claim",
     "best_argument",
     "main_objection"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "claim": {
      "type": "string"
     },
     "best_argument": {
      "type": "string"
     },
     "main_objection": {
      "type": "string"
     }
    }
   }
  },
  "worked_example": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "body_md"
   ],
   "properties": {
    "body_md": {
     "type": "string"
    }
   }
  },
  "misconception": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "claim",
    "correction_md"
   ],
   "properties": {
    "claim": {
     "type": "string"
    },
    "correction_md": {
     "type": "string"
    }
   }
  },
  "cards": {
   "type": "array",
   "minItems": 5,
   "maxItems": 8,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "title",
     "body_md",
     "visual"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^c[0-9]+$"
     },
     "kind": {
      "enum": [
       "guess",
       "hook",
       "method",
       "numbers",
       "picture",
       "analogy",
       "idea",
       "myth",
       "takeaway"
      ]
     },
     "title": {
      "type": "string",
      "maxLength": 60
     },
     "body_md": {
      "type": "string",
      "maxLength": 420
     },
     "visual": {
      "$ref": "#/$defs/visual"
     }
    }
   }
  },
  "recall_items": {
   "type": "array",
   "minItems": 6,
   "maxItems": 10,
   "items": {
    "$ref": "#/$defs/recall_item"
   },
   "allOf": [
    {
     "contains": {
      "type": "object",
      "properties": {
       "probe": {
        "const": true
       }
      },
      "required": [
       "probe"
      ]
     },
     "minContains": 1,
     "maxContains": 1
    },
    {
     "contains": {
      "type": "object",
      "properties": {
       "first_check": {
        "const": true
       }
      },
      "required": [
       "first_check"
      ]
     },
     "minContains": 3,
     "maxContains": 3
    }
   ]
  },
  "teach_back": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "prompt",
    "rubric",
    "min_points",
    "false_claims"
   ],
   "properties": {
    "prompt": {
     "type": "string"
    },
    "rubric": {
     "type": "array",
     "minItems": 3,
     "maxItems": 5,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "point"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "point": {
        "type": "string"
       }
      }
     }
    },
    "min_points": {
     "type": "integer",
     "minimum": 2
    },
    "false_claims": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "challenge": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "prompt",
    "model_answer"
   ],
   "properties": {
    "kind": {
     "enum": [
      "spot_the_flaw",
      "argue_other_side",
      "estimate",
      "predict"
     ]
    },
    "prompt": {
     "type": "string"
    },
    "model_answer": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "follow_up": {
     "type": "string"
    }
   }
  },
  "connections": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "to",
     "body_md"
    ],
    "properties": {
     "to": {
      "type": "string",
      "pattern": "^[a-z]{3}[0-9]{2}$"
     },
     "body_md": {
      "type": "string"
     }
    }
   }
  },
  "deep_dive": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "body_md",
    "est_minutes"
   ],
   "properties": {
    "body_md": {
     "type": "string"
    },
    "est_minutes": {
     "type": "integer"
    }
   }
  },
  "go_further": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "title",
     "note"
    ],
    "properties": {
     "kind": {
      "enum": [
       "short",
       "long",
       "book",
       "video",
       "lecture"
      ]
     },
     "title": {
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "year": {
      "type": "integer"
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "note": {
      "type": "string"
     },
     "verified_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "url",
     "tier",
     "accessed",
     "supports"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "tier": {
      "enum": [
       "research",
       "textbook",
       "reference",
       "institution",
       "popular"
      ]
     },
     "accessed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
     },
     "supports": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "verification": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "checked_on",
    "notes"
   ],
   "properties": {
    "status": {
     "enum": [
      "draft",
      "verified",
      "flagged"
     ]
    },
    "checked_on": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  }
 },
 "$defs": {
  "option": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "text"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "text": {
     "type": "string"
    }
   }
  },
  "visual": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "alt",
      "svg"
     ],
     "properties": {
      "kind": {
       "const": "svg"
      },
      "alt": {
       "type": "string",
       "minLength": 5
      },
      "svg": {
       "type": "string",
       "pattern": "^<svg",
       "maxLength": 8000
      },
      "caption": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "alt",
      "chart"
     ],
     "properties": {
      "kind": {
       "const": "chart"
      },
      "alt": {
       "type": "string",
       "minLength": 5
      },
      "caption": {
       "type": "string"
      },
      "chart": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "type",
        "x_label",
        "y_label",
        "series"
       ],
       "properties": {
        "type": {
         "enum": [
          "line",
          "bar",
          "scatter"
         ]
        },
        "x_label": {
         "type": "string"
        },
        "y_label": {
         "type": "string"
        },
        "series": {
         "type": "array",
         "minItems": 1,
         "maxItems": 4,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "name",
           "points"
          ],
          "properties": {
           "name": {
            "type": "string"
           },
           "points": {
            "type": "array",
            "minItems": 2,
            "items": {
             "type": "array",
             "prefixItems": [
              {
               "type": [
                "number",
                "string"
               ]
              },
              {
               "type": "number"
              }
             ],
             "minItems": 2,
             "maxItems": 2
            }
           }
          }
         }
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "alt",
      "src",
      "credit",
      "licence"
     ],
     "properties": {
      "kind": {
       "const": "image"
      },
      "alt": {
       "type": "string",
       "minLength": 5
      },
      "src": {
       "type": "string"
      },
      "credit": {
       "type": "string"
      },
      "licence": {
       "type": "string"
      },
      "caption": {
       "type": "string"
      }
     }
    }
   ]
  },
  "recall_item": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "prompt",
    "answer",
    "grading",
    "first_check",
    "probe"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^r[0-9]+$"
    },
    "kind": {
     "enum": [
      "free_recall",
      "cloze",
      "mcq",
      "number",
      "apply",
      "explain",
      "true_false",
      "compare"
     ]
    },
    "prompt": {
     "type": "string"
    },
    "options": {
     "type": "array",
     "minItems": 2,
     "items": {
      "$ref": "#/$defs/option"
     }
    },
    "answer": {
     "type": "string"
    },
    "accept": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "explanation": {
     "type": "string"
    },
    "grading": {
     "enum": [
      "auto",
      "self"
     ]
    },
    "first_check": {
     "type": "boolean"
    },
    "probe": {
     "type": "boolean"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "mcq"
       }
      }
     },
     "then": {
      "required": [
       "options"
      ],
      "properties": {
       "grading": {
        "const": "auto"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "cloze"
       }
      }
     },
     "then": {
      "required": [
       "accept"
      ],
      "properties": {
       "grading": {
        "const": "auto"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "true_false"
       }
      }
     },
     "then": {
      "properties": {
       "grading": {
        "const": "auto"
       },
       "answer": {
        "enum": [
         "true",
         "false"
        ]
       }
      }
     }
    }
   ]
  }
 }
}